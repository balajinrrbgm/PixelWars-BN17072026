# =============================================================================
# PixelWars — Environment Variables
# =============================================================================

# AWS — DynamoDB access
# Use Vercel OIDC integration (recommended) or IAM credentials
AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# DynamoDB table name
DYNAMODB_TABLE_NAME="pixelwars-prod"

# WebSocket API Gateway endpoint (from CloudFormation output)
WEBSOCKET_API_ENDPOINT="wss://your-api-id.execute-api.eu-central-1.amazonaws.com/prod"
NEXT_PUBLIC_WEBSOCKET_URL="wss://your-api-id.execute-api.eu-central-1.amazonaws.com/prod"

# WebSocket management API (for Lambda to push messages to clients)
WEBSOCKET_MANAGEMENT_ENDPOINT="https://your-api-id.execute-api.eu-central-1.amazonaws.com/prod"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# App settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CANVAS_WIDTH="1000"
NEXT_PUBLIC_CANVAS_HEIGHT="1000"
NEXT_PUBLIC_COOLDOWN_SECONDS="300"
